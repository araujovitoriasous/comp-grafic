# Cornell Box
mtllib box.mtl

# Floor
v -1.0 -1.0 -1.0
v 1.0 -1.0 -1.0
v 1.0 -1.0 1.0
v -1.0 -1.0 1.0

# Ceiling
v -1.0 1.0 -1.0
v 1.0 1.0 -1.0
v 1.0 1.0 1.0
v -1.0 1.0 1.0

# Back Wall
v -1.0 -1.0 -1.0
v 1.0 -1.0 -1.0
v 1.0 1.0 -1.0
v -1.0 1.0 -1.0

# Left Wall (Red usually, but using texture)
v -1.0 -1.0 1.0
v -1.0 -1.0 -1.0
v -1.0 1.0 -1.0
v -1.0 1.0 1.0

# Right Wall (Green usually, but using texture)
v 1.0 -1.0 -1.0
v 1.0 -1.0 1.0
v 1.0 1.0 1.0
v 1.0 1.0 -1.0

# Short Box
v 0.3 -1.0 0.3
v 0.8 -1.0 0.0
v 0.8 -0.4 0.0
v 0.3 -0.4 0.3
v 0.3 -1.0 -0.3
v 0.8 -1.0 -0.6
v 0.8 -0.4 -0.6
v 0.3 -0.4 -0.3

# Tall Box
v -0.8 -1.0 0.3
v -0.3 -1.0 -0.2
v -0.3 0.2 -0.2
v -0.8 0.2 0.3
v -0.8 -1.0 -0.3
v -0.3 -1.0 -0.8
v -0.3 0.2 -0.8
v -0.8 0.2 -0.3

# Normals
vn 0 1 0
vn 0 -1 0
vn 0 0 1
vn 0 0 -1
vn 1 0 0
vn -1 0 0

# Tex Coords (Simple)
vt 0 0
vt 1 0
vt 1 1
vt 0 1

usemtl TestMaterial

# Floor
f 1/1/1 2/2/1 3/3/1 4/4/1
# Ceiling
f 5/1/2 8/4/2 7/3/2 6/2/2
# Back
f 9/1/3 10/2/3 11/3/3 12/4/3
# Left
f 13/1/5 14/2/5 15/3/5 16/4/5
# Right
f 17/1/6 18/2/6 19/3/6 20/4/6

# Boxes (Simplified faces)
# Short Box Top
f 24/1/1 23/2/1 22/3/1 21/4/1
# Short Box Front
f 21/1/3 22/2/3 26/3/3 25/4/3

# Tall Box Top
f 32/1/1 31/2/1 30/3/1 29/4/1
# Tall Box Front
f 29/1/3 30/2/3 34/3/3 33/4/3
